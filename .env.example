# Mẫu cấu hình; đặt các biến này trong môi trường của tiến trình chạy Flask.
# Không đưa khóa thật vào mã nguồn hoặc commit tệp .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FLASK_SECRET_KEY=

# Tùy chọn: dùng nhà cung cấp khác khi chưa lưu cấu hình trong Cài đặt.
# SUPPORT_AI_PROVIDER: gemini | openai | anthropic | deepseek | compatible
SUPPORT_AI_PROVIDER=
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=
SUPPORT_AI_BASE_URL=
